# =============================================================================
# Atlas web (.env.local) — copy from this template and fill values.
# Production is Heroku-hosted. Inference/reflection call the Heroku MCP app,
# which forwards to RunPod Ollama (GPU). Do not point these at localhost in prod.
# =============================================================================

# --- Firebase (legacy / optional surfaces) ---
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# --- App ---
VITE_APP_ID=atlas-demo

# --- Supabase (single pane + Auth; publishable/anon key in the browser only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy name:
# VITE_SUPABASE_ANON_KEY=
# Optional absolute URL for auth email/OAuth callbacks (example: https://atlas.yourdomain.com/).
# VITE_SUPABASE_AUTH_REDIRECT_URL=
# When true in development, the web app loads live Supabase data and requires sign-in when URL/key are set.
# VITE_ENABLE_SINGLEPANE_SUPABASE_BOOTSTRAP=true
# Sensitive local browser caching for intake/program payloads is disabled by default.
# VITE_ALLOW_SENSITIVE_LOCAL_CACHE=false
# Shared passcode for /demo preview on the public landing flow.
# VITE_ATLAS_DEMO_PASSCODE=

# =============================================================================
# Heroku MCP → RunPod Ollama (required for live inference / C.R.E.A.T.E. reflection)
# Set these on the Atlas Heroku app config vars (same names).
# MCP app owns: POST /infer-zcodes, POST /summarize-create-session, GET /health
# =============================================================================
# Z-code inference (Atlas demo referral / claim flow)
VITE_ATLAS_DEMO_INFERENCE_URL=https://<mcp-heroku-app>.herokuapp.com/infer-zcodes
# C.R.E.A.T.E. supervisor reflection (Section 3 narrative)
VITE_ATLAS_CREATE_REFLECTION_URL=https://<mcp-heroku-app>.herokuapp.com/summarize-create-session
# Shared bearer; must equal ATLAS_MCP_BEARER_TOKEN on the MCP Heroku app
VITE_ATLAS_DEMO_INFERENCE_BEARER=

# Local-only defaults if the vars above are unset during MCP development:
#   infer → http://localhost:4310/infer-zcodes
#   reflect → http://localhost:4310/summarize-create-session

# --- Google Maps ---
# Get your key from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# --- AlayaCare browser configuration ---
# IMPORTANT: Never place client secrets in VITE_* variables.
# Browser requests must go through a trusted backend broker that stores OAuth credentials server-side.
VITE_ALAYACARE_BROKER_URL=
VITE_ALAYACARE_TENANT_ID=your_tenant_id
VITE_ALAYACARE_ENABLED=false
