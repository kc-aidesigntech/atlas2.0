# Atlas web — copy to .env.local (or set on Heroku app atlas-simplified, then redeploy)

# App
VITE_APP_ID=atlas-demo

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_AUTH_REDIRECT_URL=
# VITE_ENABLE_SINGLEPANE_SUPABASE_BOOTSTRAP=true
# VITE_ALLOW_SENSITIVE_LOCAL_CACHE=false
# VITE_ATLAS_DEMO_PASSCODE=

# MCP (atlas-mcp-server) — bearer must match ATLAS_MCP_BEARER_TOKEN
VITE_ATLAS_MCP_BASE_URL=https://atlas-mcp-server-1117efe08e58.herokuapp.com
VITE_ATLAS_MCP_BEARER=

# Scribe subapp — hostname that should render Atlas Scribe at its root
# (e.g. scribe.example.org). Requires the custom domain on the Heroku app and
# a DNS CNAME; see docs/it/scribe.md. Leave unset to use the /scribe path only.
# VITE_ATLAS_SCRIBE_HOSTNAME=

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# AlayaCare (no client secrets in VITE_*)
VITE_ALAYACARE_BROKER_URL=
VITE_ALAYACARE_TENANT_ID=
VITE_ALAYACARE_ENABLED=false
